# Keep PAYMENT_PROVIDER=INTERNAL until the complete MTN sandbox checklist passes.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
CORS_ORIGIN=http://localhost:5173

PAYMENT_PROVIDER=INTERNAL
MTN_ENVIRONMENT=sandbox
MTN_VERIFY_RECEIVER_NAME=true
# Leave PAYMENT_PROVIDER=INTERNAL until the documented sandbox work passes.
# Live Disbursement credentials are server deployment secrets only.
MTN_DISBURSEMENT_PRIMARY_KEY=
MTN_DISBURSEMENT_USER_ID=
MTN_DISBURSEMENT_API_KEY=
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_CALLBACK_URL=
MTN_WEBHOOK_SECRET_OR_SIGNATURE_KEY=
