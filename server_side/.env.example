# Keep PAYMENT_PROVIDER=INTERNAL until the complete MTN sandbox checklist passes.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
CORS_ORIGIN=http://localhost:5173
CLIENT_APP_URL=http://localhost:5173

# Optional SMTP. Public password reset is limited to OWNER and SUPER_ADMIN.
# Managers, Accountants, Suppliers, and Workers stay Owner-managed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CMK Mining Operations <no-reply@example.com>"
OWNER_REPORT_EMAILS_ENABLED=false
# Owner summaries are delivered at 23:59 in this timezone: daily every day,
# weekly on Sunday, and monthly on the actual final calendar day.
REPORT_TIMEZONE=Africa/Kigali

PAYMENT_PROVIDER=INTERNAL
MTN_ENVIRONMENT=sandbox
MTN_VERIFY_RECEIVER_NAME=true
# Leave PAYMENT_PROVIDER=INTERNAL until the documented sandbox work passes.
# Live Disbursement credentials are server deployment secrets only.
MTN_DISBURSEMENT_PRIMARY_KEY=
MTN_DISBURSEMENT_USER_ID=
MTN_DISBURSEMENT_API_KEY=
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_DISBURSEMENT_CALLBACK_URL=
MTN_WEBHOOK_SECRET_OR_SIGNATURE_KEY=
